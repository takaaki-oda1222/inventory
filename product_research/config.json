  "dedupe": {
    "name_similarity": 0.85,
    "token_containment": true,
    "stopwords": ["the", "a", "an", "new", "best", "original", "premium", "2024", "2025", "2026", "pro", "for", "with"]
  },
  "sourcing": {
    "min_match_score": 70,
    "name_similarity": 0.8
  },
  "pricing": {
    "currency": "USD",
    "markups": [2.5, 3.0, 4.0],
    "price_ending": 0.99,
    "payment_fee_rate": 0.04,
    "est_cpa": 12.0,
    "min_margin_rate": 0.25
  },
  "gates": {
    "reaction_min_likes": 600
  },
  "compliance": {
    "ng_keywords": ["knife", "knives", "blade", "taser", "stun gun", "pepper spray", "gun", "weapon", "cbd", "thc", "vape", "e-cigarette", "nicotine", "fat burner", "weight loss pill", "diet pill", "supplement", "prescription", "contact lens", "drone", "laser pointer", "lock pick", "replica", "brand inspired"],
    "review_keywords": ["battery", "batteries", "rechargeable", "lithium", "usb", "electric", "heating", "heated", "baby", "kids", "child", "toy", "skin", "cosmetic", "serum", "cream", "teeth", "whitening", "medical", "pain relief", "posture", "massager", "food", "kitchen", "pet food", "magnet", "led", "laser", "hair removal", "car seat"]
  },
  "scoring": {
    "weights": {"appeal": 40, "margin": 25, "match": 15, "longevity": 10, "ad_count": 10},
    "appeal_likes_ref": 10000,
    "longevity_days_ref": 60,
    "ad_count_ref": 5
  }
